[Unit]
Description=Excel Ingestion Agent
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/excel-ingestion-agent
ExecStart=/opt/excel-ingestion-agent/venv/bin/python /opt/excel-ingestion-agent/app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
